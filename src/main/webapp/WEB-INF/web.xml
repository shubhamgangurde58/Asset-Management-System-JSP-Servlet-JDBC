<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>Asset-Management-System-JSP-Servlet</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
  </welcome-file-list>
  
  	<servlet>
  		<servlet-name>SignUpServlet</servlet-name>
  		<servlet-class>com.shubham.controller.SignUpServlet</servlet-class>
  	</servlet>
  	
  	<servlet-mapping>
  		<servlet-name>SignUpServlet</servlet-name>
  		<url-pattern>/SignUpServlet</url-pattern>
  	</servlet-mapping>
  	
  	<servlet>
  		<servlet-name>LoginServlet</servlet-name>
  		<servlet-class>com.shubham.controller.LoginServlet</servlet-class>
  	</servlet>
  	
  	<servlet-mapping>
  		<servlet-name>LoginServlet</servlet-name>
  		<url-pattern>/LoginServlet</url-pattern>
  	</servlet-mapping>
  	
  	<servlet>
  		<servlet-name>AddAsset</servlet-name>
  		<servlet-class>com.shubham.controller.AddAsset</servlet-class>
  	</servlet>
  	
  	<servlet-mapping>
  		<servlet-name>AddAsset</servlet-name>
  		<url-pattern>/AddAsset</url-pattern>
  	</servlet-mapping>
  	
  	<servlet>
		<servlet-name>DeleteAsset</servlet-name>
		<servlet-class>com.shubham.controller.DeleteAsset</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>DeleteAsset</servlet-name>
		<url-pattern>/DeleteAsset</url-pattern>
	</servlet-mapping>
  
  
  	<servlet>
		<servlet-name>ExportExcelServlet</servlet-name>
		<servlet-class>com.shubham.controller.ExportExcelServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>ExportExcelServlet</servlet-name>
		<url-pattern>/ExportExcelServlet</url-pattern>
	</servlet-mapping>
  
  
  	<servlet>
		<servlet-name>UpdateAsset</servlet-name>	
		<servlet-class>com.shubham.controller.UpdateAsset</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>UpdateAsset</servlet-name>
		<url-pattern>/UpdateAsset</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>ViewAsset</servlet-name>	
		<servlet-class>com.shubham.controller.ViewAsset</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>ViewAsset</servlet-name>
		<url-pattern>/ViewAsset</url-pattern>
	</servlet-mapping>
  
</web-app>